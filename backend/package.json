{
  "name": "@ferremax/backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node --import tsx prisma/seed.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "cors": "^2.8.5",
    "helmet": "^8.1.0",
    "cookie-parser": "^1.4.7",
    "express-rate-limit": "^7.5.1",
    "bcryptjs": "^3.0.2",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.25.76",
    "dotenv": "^16.6.1",
    "@prisma/client": "6.19.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "tsx": "^4.20.6",
    "prisma": "6.19.0",
    "@types/node": "^22.18.0",
    "@types/express": "^4.17.23",
    "@types/cors": "^2.8.19",
    "@types/cookie-parser": "^1.4.9",
    "@types/jsonwebtoken": "^9.0.10"
  }
}
